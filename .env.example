# Copy this file to .env, then paste your key after the = sign.
# .env is git-ignored. Never commit it, never paste it into a chat or a PR.
GEMINI_API_KEY=

# Optional. Leave commented out to use the default (gemini-3.8-flash).
# If you hit rate limits, try gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.8-flash
